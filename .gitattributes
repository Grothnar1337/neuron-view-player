# Everything in this repo is authored on Windows and executed on an Ubuntu VM,
# so normalise to LF everywhere rather than per-extension. CRLF breaks the
# shebang on the deploy scripts and is meaningless in the systemd units and
# SDP files. This overrides core.autocrlf, so it holds regardless of how any
# given clone is configured.
* text=auto eol=lf

# Belt and braces for the files where CRLF would actually break something.
*.sh      text eol=lf
*.yml     text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.sdp     text eol=lf
*.example text eol=lf
